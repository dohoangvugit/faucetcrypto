{{#if isLogin}}
<form action="/auth/login" method="POST">
  <div class="mb-3">
    <label class="form-label text-light">Email</label>
    <input type="text" name="login" class="form-control custom-input" placeholder="name@example.com hoặc matic_king" required>
  </div>
  <div class="mb-3">
    <label class="form-label text-light">Password</label>
    <input type="password" name="password" class="form-control custom-input" placeholder="••••••••" required>
  </div>
  <div class="d-grid gap-2 mt-4">
    <button type="submit" class="btn btn-primary btn-auth">Login</button>
  </div>
</form>

<!-- Divider -->
<div class="divider my-4 text-center text-light">
  <span>Đăng nhập ngay</span>
</div>

<!-- Google button -->
<div class="text-center mt-3">
  <button class="btn btn-danger btn-auth btn-google">
    <i class="bi bi-google"></i>
  </button>
</div>
  <p class="text-center mt-3 text-light">Don't have an account yet?<a href="/register" class="text-info">Register</a></p>
{{else}}
  <form action="/auth/register" method="POST">
    <div class="mb-3">
      <label class="form-label text-light">Username</label>
      <input type="text" name="username" class="form-control custom-input" placeholder="matic_king" required>
    </div>
    <div class="mb-3">
      <label class="form-label text-light">Email</label>
      <input type="email" name="email" class="form-control custom-input" placeholder="name@example.com" required>
    </div>
    <div class="mb-3">
      <label class="form-label text-light">Password</label>
      <input type="password" name="password" class="form-control custom-input" required>
    </div>
    <div class="d-grid gap-2 mt-4">
      <button type="submit" class="btn btn-primary btn-auth">Register</button>
    </div>
  </form>
  <p class="text-center mt-3 text-light">Already registed? Login now<a href="/login" class="text-info">Login</a></p>
{{/if}}