<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="card auth-card">
    <div class="card-body p-5">
        <h3 class="text-center mb-4 fw-bold">Tạo Tài Khoản</h3>
        <form action="/auth/register" method="POST">
            <div class="mb-3">
                <label class="form-label">Tên người dùng</label>
                <input type="text" name="username" class="form-control" placeholder="Vu_Crypto" required>
            </div>
            <div class="mb-3">
                <label class="form-label">Email</label>
                <input type="email" name="email" class="form-control" placeholder="name@example.com" required>
            </div>
            <div class="mb-3">
                <label class="form-label">Mật khẩu</label>
                <input type="password" name="password" class="form-control" required>
            </div>
            <button type="submit" class="btn btn-success w-100 py-2 mb-3">Đăng ký tài khoản</button>
            
            <div class="text-center">
                <p class="mb-0 small">Đã có tài khoản? <a href="/login">Đăng nhập</a></p>
            </div>
        </form>
    </div>
</div>