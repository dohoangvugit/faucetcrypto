<div class="container mt-5">
  <div class="row">

    <div class="col-xl-3 col-lg-4 col-md-5">
      <div id="sidebar-block" class="box-shadow box-style mt-3 text-white p-3">

        <div class="user mb-3">
          <div class="info">
            <span class="fw-bold">{{user.username}}</span><br>
          </div>
        </div>

        <div class="inner mb-3">
          <div class="block">
            <div class="data">
              <div class="align-items-center">
                <div class="col-12">
                  Balance
                  <div class="fw-bold">{{user.balance}}</div>
                </div>
              </div>
            </div>
          </div>

          <button class="btn btn-success btn-sm w-100 mt-3">
            Withdraw
          </button>
        </div>

      </div>
    </div>

    <div class="col-xl-9 col-lg-8 col-md-7">
      <div class="row">
        {{#each tasks}}
        <div class="col-sm-6 col-lg-4 mb-4">
          <div class="card h-100 shadow-sm position-relative">

            <div class="card-header bg-light fw-bold text-center">
              {{title}}
            </div>

            <div class="card-body position-relative text-center" style="min-height:100px;" >
              <div>
                {{description}}
              </div>

            </div>

            <div class="card-footer d-flex justify-content-between align-items-center">
              <span> <i class="bi bi-coin"></i> {{reward_amount}}</span>
              <span> <i class="bi bi-alarm-fill"></i> {{cooldown_seconds}}s</span>
            </div>

            <a href="{{link_url}}" class="btn btn-success btn-sm w-100 mt-1">
              🔗 Visit
            </a>

          </div>            
        </div>
        {{/each}}
      </div>
    </div>

  </div>
</div>