<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="card auth-card">
    <div class="card-body p-5">
        <h3 class="text-center mb-4 fw-bold">Đăng Nhập</h3>
        <form action="/auth/login" method="POST">
            <div class="mb-3">
                <label class="form-label">Email</label>
                <input type="email" name="email" class="form-control" placeholder="name@example.com" required>
            </div>
            <div class="mb-3">
                <label class="form-label">Mật khẩu</label>
                <input type="password" name="password" class="form-control" required>
            </div>
            <button type="submit" class="btn btn-primary w-100 py-2 mb-3">Đăng nhập</button>
            
            <div class="text-center">
                <p class="text-muted small">Hoặc đăng nhập với</p>
                <a href="/auth/google" class="btn btn-outline-danger w-100 mb-3">
                    <i class="fab fa-google"></i> Google
                </a>
                <p class="mb-0 small">Chưa có tài khoản? <a href="/register">Đăng ký ngay</a></p>
            </div>
        </form>
    </div>
</div>